<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/mx_black</item>
        <item name="android:navigationBarColor">@color/mx_black</item>
        <item name="android:windowBackground">@color/mx_black</item>
        <item name="android:windowSplashScreenBackground">@color/mx_black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/mailxperts_icon</item>
        <item name="android:colorAccent">@color/mx_teal</item>
    </style>
    <style name="AppTheme.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/mx_white</item>
        <item name="android:navigationBarColor">@color/mx_white</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/mx_white</item>
        <item name="android:windowSplashScreenBackground">@color/mx_white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/mailxperts_icon</item>
        <item name="android:colorAccent">@color/mx_teal_dark</item>
    </style>
</resources>
